//Hill climber algorithm


def f(x):
    return -(x - 8) ** 2 + 64


x = 1
print("Start: x =", x)

while True:
    print("Current x =", x, "f(x) =", f(x))

    if f(x + 1) > f(x):
        x += 1
        print("Move to x =", x)

    elif f(x - 1) > f(x):
        x -= 1
        print("Move to x =", x)

    else:
        print("No better neighbor found.")
        break

print("Best x =", x)
print("Maximum value =", f(x))


